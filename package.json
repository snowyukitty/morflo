{
  "name": "morflo",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "version": "0.3.0",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "vite",
    "tauri": "tauri",
    "tauri:dev": "node scripts/tauri-dev.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:windows-open-with": "node scripts/generate-windows-open-with.mjs",
    "check:windows-open-with": "node scripts/generate-windows-open-with.mjs --check",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "check:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "check": "pnpm format:check && pnpm check:windows-open-with && pnpm lint && pnpm typecheck && pnpm check:rust",
    "test:unit": "vitest run",
    "test:engine": "node --test scripts/engine-verify.test.mjs scripts/engine-dossier.test.mjs",
    "test": "pnpm test:unit && pnpm test:engine && cargo test --manifest-path src-tauri/Cargo.toml",
    "test:real": "cargo test --manifest-path src-tauri/Cargo.toml --features real-engine --test real_engine -- --ignored --nocapture && cargo test --manifest-path src-tauri/Cargo.toml --features real-engine --lib real_process_tree_cancellation_stops_the_encoder_promptly -- --ignored --nocapture",
    "test:e2e": "playwright test",
    "test:native:windows": "node scripts/test-native-windows.mjs",
    "test:native:gif:windows": "node scripts/test-native-gif-windows.mjs",
    "test:native:cancel:windows": "node scripts/test-native-cancellation-windows.mjs",
    "test:native:open-with:windows": "node scripts/test-native-open-with-windows.mjs",
    "test:installer:open-with:windows": "node scripts/test-open-with-installer-windows.mjs",
    "engine:verify": "node scripts/engine-verify.mjs",
    "engine:dossier": "node scripts/engine-dossier.mjs",
    "build:frontend": "vite build",
    "build": "pnpm build:frontend && cargo build --manifest-path src-tauri/Cargo.toml --release",
    "package": "pnpm package:windows",
    "package:windows": "pnpm generate:windows-open-with && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1",
    "package:reviewed-engine": "pnpm generate:windows-open-with && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1 -RequireReviewedEngine",
    "package:inspect-engine-free": "node scripts/inspect-engine-free-package.mjs",
    "generate-fixtures": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-fixtures.ps1",
    "benchmark:gif": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/benchmark-gif.ps1",
    "measure:performance": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/measure-engine-performance.ps1 && playwright test tests/e2e/performance.spec.ts",
    "audit:privacy": "node scripts/audit-privacy.mjs",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "verify:quality": "pnpm check && pnpm test && pnpm test:e2e && pnpm build:frontend && pnpm audit:privacy && pnpm audit:prod",
    "verify": "pnpm generate-fixtures && pnpm verify:quality && pnpm test:real && cargo build --manifest-path src-tauri/Cargo.toml --release"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "lucide-react": "1.39.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "4.13.0",
    "eslint": "10.9.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
